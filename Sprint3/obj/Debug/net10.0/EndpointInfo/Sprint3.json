            "pattern": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
            "type": "string"
          },
          "especialidade": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Disciplina": {
        "required": [
          "cargaHoraria",
          "id",
          "nome"
