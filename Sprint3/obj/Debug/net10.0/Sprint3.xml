        </member>
        <member name="M:Sprint3.Controllers.AlunoController.GetAlunoById(System.Int32)">
            <summary>
            Obtém os detalhes de um aluno específico pelo ID.
            </summary>
            <param name="id">ID numérico do aluno.</param>
            <response code="200">Retorna o aluno encontrado.</response>
            <response code="404">Se o aluno não for encontrado.</response>
        </member>
        <member name="M:Sprint3.Controllers.AlunoController.PostAluno(Sprint3.DTOs.Requests.CreateAlunoDTO)">
            <summary>
            Cadastra um novo aluno.
            </summary>
            <remarks>
            Exemplo de requisição:
            
                POST /api/Aluno
                {
                   "nome": "João Silva",
                   "cpf": "12345678901",
                   "dataNascimento": "2005-01-01",
                   "matricula": "A2024001"
                }
            </remarks>
            <response code="201">Aluno criado com sucesso.</response>
            <response code="400">Dados inválidos ou CPF/Matrícula já existente.</response>
        </member>
        <member name="M:Sprint3.Controllers.AlunoController.PatchAluno(System.Int32,Sprint3.DTOs.Requests.UpdateAlunoDTO)">
            <summary>
